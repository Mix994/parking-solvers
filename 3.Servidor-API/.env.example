# Copie para .env (nunca commite o .env real) ou configure no painel do provedor (Render / Railway / VPS).

SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Banco PostgreSQL
DB_URL=jdbc:postgresql://HOST:5432/smartpark
DB_USER=smartpark
DB_PASSWORD=troque-por-uma-senha-forte

# Chave secreta JWT (mínimo 32 caracteres aleatórios)
JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Fuso de negócio (turnos e período "Hoje" no dashboard)
SMARTPARK_TIMEZONE=America/Sao_Paulo

# Swagger em produção (deixe false ou habilite apenas se necessário)
SWAGGER_ENABLED=false

# Bootstrap do primeiro administrador (usado apenas se a tabela usuario estiver vazia)
ADMIN_INITIAL_NAME=Administrador
ADMIN_INITIAL_LOGIN=admin@campus.edu.br
ADMIN_INITIAL_PASSWORD=troque-por-senha-forte-min-8
